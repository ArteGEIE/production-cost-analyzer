# Copy to .env and fill in. Every variable the app reads is listed here.
# Docs: docs/configuration.md

# ----- LLM (extraction + compliance comments) -----
# Any OpenAI-compatible endpoint. Does NOT talk to the Anthropic API directly:
# put a LiteLLM proxy in front of Anthropic/Mistral/Ollama/… or use OpenAI.
#
#   LiteLLM proxy:  LLM_BASE_URL=http://localhost:4000/v1   LLM_API_KEY=sk-1234
#   OpenAI direct:  LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=sk-1234
# Model name as known by the endpoint above
LLM_MODEL=claude-sonnet-4-6

# ----- OCR fallback for scanned PDFs (required) -----
MISTRAL_API_KEY=your-mistral-api-key
# OCR_MODEL=mistral-ocr-latest

# ----- Database (PostgreSQL 15+) -----
DATABASE_URL=postgresql://pcost:pcost@localhost:5432/pcost
# Connections per app process (default 5)
# DATABASE_POOL_MAX=5

# ----- Logging -----
# debug | info | warn | error | silent (default: debug in dev, info in production).
# Keep info or above in production: debug logs excerpts of the uploaded devis.
# LOG_LEVEL=info

# ----- Authentication (Auth.js v5) -----
# At least ONE provider must be configured — the app refuses to start otherwise.
#
# Mode 1: OIDC (recommended). Any OIDC provider: Keycloak, Auth0, Authentik,
# Google Workspace, Entra ID… Redirect URI to register on the client:
#   http://localhost:3000/api/auth/callback/oidc   (dev)
#   https://<your-domain>/api/auth/callback/oidc   (prod)
AUTH_OIDC_ISSUER=https://sso.example.com/realms/your-realm
AUTH_OIDC_CLIENT_ID=production-cost-analyzer
# Leave empty for public clients using PKCE (default)
AUTH_OIDC_CLIENT_SECRET=
# Label on the sign-in button — defaults to "SSO"
AUTH_OIDC_NAME=
# Restrict access to members of a group claim.
# REQUIRED when OIDC is configured, unless AUTH_OIDC_ALLOW_ANY=true is set.
AUTH_REQUIRED_GROUP=
# Explicit opt-out of the group restriction — allows any authenticated OIDC user.
# Only when your IdP exposes no group claim.
# AUTH_OIDC_ALLOW_ANY=true

# Mode 2: Demo (no real auth). A "Try the demo" button on /sign-in logs visitors
# in as a fixed fictional user. Never enable on an instance holding real data.
# Load the demo dataset separately with `npm run db:seed:demo`.
# DEMO_MODE=true

# Shared
# Required behind a reverse proxy / in containers
AUTH_TRUST_HOST=true
# Public URL of the app (also whitelists its host for Server Actions)
AUTH_URL=http://localhost:3000
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Extra hostnames allowed to call Server Actions, comma-separated (behind a
# proxy that rewrites Host). AUTH_URL's host is always included.
# SERVER_ACTIONS_ALLOWED_ORIGINS=

# ----- Branding & theme (all optional) -----
# Product name shown in the header, sign-in page and browser title
# APP_NAME=Production cost
# Small badge next to the name, e.g. Beta (hidden when empty)
# APP_BADGE=Beta
# Logo image — absolute URL or a path under public/ (e.g. /logo.svg)
# APP_LOGO_URL=
# APP_FAVICON_URL=
# Theme: oklch hue (0–360) and chroma (0–0.4) of the primary colour; all tinted
# tokens (accents, borders, charts) follow the hue. Default: 28.5 / 0.222 (orange).
# APP_THEME_HUE=250
# APP_THEME_CHROMA=0.18
# Or force an explicit primary colour (any CSS colour) and its text colour
# APP_PRIMARY_COLOR=#0055ff
# APP_PRIMARY_FOREGROUND_COLOR=white
# Extra stylesheet loaded after the built-in theme for deeper customisation
# APP_THEME_CSS_URL=/theme.css

# ----- Referentials -----
# Directory with replacement JSON files for config/ (production-types.json,
# cnc-mapping.json, cc-minimums.json, structural-thresholds.json). Missing files
# fall back to the bundled ones. Values edited in the settings UI still win.
# APP_CONFIG_DIR=/app/config-overrides

# ----- Data import scripts (npm run db:seed:xlsm / db:seed:cc:xlsm) -----
# HISTORY_XLSM_PATH=documents/history.xlsm
# HISTORY_XLSM_PRODUCTION_TYPE=Reportage

# ----- Third-party scripts -----
# Feedback widgets, analytics tags and chat loaders are not configured through
# environment variables: add a gitignored public/custom.js before building.
# See docs/configuration.md.
