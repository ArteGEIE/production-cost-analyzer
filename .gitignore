# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# database
/data/*.db

# vercel
.vercel

# generated test fixtures (regenerate with: npx tsx fixtures/generate-pdfs.ts)
/fixtures/*.pdf

# typescript
*.tsbuildinfo
next-env.d.ts

documents

# worktrees
.worktrees

# superpowers plans (local working docs)
docs/superpowers/plans/
docs/superpowers/

# playwright MCP
.playwright-mcp/

# deployment-provided script (feedback widget, analytics…) — see docs/configuration.md
/public/custom.js
